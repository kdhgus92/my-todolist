{
  "openapi": "3.0.3",
  "info": {
    "title": "my-todolist API",
    "version": "0.1.0",
    "description": "인증된 사용자가 카테고리 기반으로 할일을 관리하는 my-todolist 서비스의 백엔드 REST API 명세."
  },
  "servers": [
    { "url": "http://localhost:3000", "description": "로컬 개발 서버" }
  ],
  "tags": [
    { "name": "Health", "description": "헬스체크" },
    { "name": "Auth", "description": "회원가입/로그인/토큰 재발급 (UC-01)" },
    { "name": "Users", "description": "사용자 정보 수정 (UC-02)" },
    { "name": "Categories", "description": "카테고리 관리 (BR-04/08/09)" },
    { "name": "Todos", "description": "할일 CRUD 및 필터링 (UC-03~06)" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "로그인 응답으로 발급된 access_token을 `Authorization: Bearer <access_token>` 헤더로 전달한다. refresh_token은 HttpOnly 쿠키로 별도 전달되며 이 스킴과 무관하다."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string",
                "description": "에러 코드",
                "example": "VALIDATION_ERROR"
              },
              "message": {
                "type": "string",
                "description": "사용자에게 노출 가능한 에러 사유",
                "example": "종료일자는 시작일자보다 빠를 수 없습니다."
              }
            }
          }
        },
        "example": {
          "error": {
            "code": "VALIDATION_ERROR",
            "message": "종료일자는 시작일자보다 빠를 수 없습니다."
          }
        }
      },
      "HealthStatus": {
        "type": "object",
        "required": ["status", "db"],
        "properties": {
          "status": { "type": "string", "enum": ["ok", "error"], "example": "ok" },
          "db": { "type": "string", "enum": ["ok", "error"], "example": "ok" }
        }
      },
      "User": {
        "type": "object",
        "description": "EN-01 User. password는 응답에 포함되지 않는다.",
        "required": ["id", "email", "name", "createdAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid", "example": "3f1b2c4e-1a2b-4c3d-9e8f-1234567890ab" },
          "email": { "type": "string", "format": "email", "maxLength": 255, "example": "jiwoo@example.com" },
          "name": { "type": "string", "maxLength": 100, "example": "김지우" },
          "createdAt": { "type": "string", "format": "date-time", "example": "2026-08-20T09:00:00.000Z" }
        }
      },
      "Category": {
        "type": "object",
        "description": "EN-02 Category",
        "required": ["id", "userId", "name", "isDefault", "createdAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid", "example": "9a8b7c6d-5e4f-3a2b-1c0d-9876543210ab" },
          "userId": { "type": "string", "format": "uuid", "example": "3f1b2c4e-1a2b-4c3d-9e8f-1234567890ab" },
          "name": { "type": "string", "maxLength": 100, "example": "과제" },
          "isDefault": { "type": "boolean", "description": "기본 카테고리 여부. 사용자당 정확히 1개이며 삭제 불가(BR-04)", "example": false },
          "createdAt": { "type": "string", "format": "date-time", "example": "2026-08-20T09:00:00.000Z" }
        }
      },
      "TodoStatus": {
        "type": "string",
        "description": "할일 상태. DB 저장값이 아닌, 조회 시점의 오늘 날짜·startDate·endDate·isDone으로부터 계산되는 파생 필드다(BR-06, 도메인 정의서 4.4절).",
        "enum": ["시작전", "진행중", "완료", "기한초과"]
      },
      "Todo": {
        "type": "object",
        "description": "EN-03 Todo. status는 저장 컬럼이 아닌 조회 시점 계산값(BR-06)이다.",
        "required": ["id", "userId", "categoryId", "title", "startDate", "endDate", "isDone", "status", "createdAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid", "example": "c1d2e3f4-5678-90ab-cdef-1234567890ab" },
          "userId": { "type": "string", "format": "uuid", "example": "3f1b2c4e-1a2b-4c3d-9e8f-1234567890ab" },
          "categoryId": { "type": "string", "format": "uuid", "example": "9a8b7c6d-5e4f-3a2b-1c0d-9876543210ab" },
          "title": { "type": "string", "maxLength": 200, "example": "알고리즘 과제 제출" },
          "startDate": { "type": "string", "format": "date", "example": "2026-08-20" },
          "endDate": { "type": "string", "format": "date", "example": "2026-08-27" },
          "isDone": { "type": "boolean", "example": false },
          "status": { "$ref": "#/components/schemas/TodoStatus" },
          "createdAt": { "type": "string", "format": "date-time", "example": "2026-08-19T12:00:00.000Z" }
        }
      },
      "SignupRequest": {
        "type": "object",
        "required": ["email", "password", "name"],
        "properties": {
          "email": { "type": "string", "format": "email", "maxLength": 255, "example": "jiwoo@example.com" },
          "password": { "type": "string", "format": "password", "minLength": 8, "description": "최소 8자 이상", "example": "password123" },
          "name": { "type": "string", "minLength": 1, "maxLength": 100, "example": "김지우" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email", "maxLength": 255, "example": "jiwoo@example.com" },
          "password": { "type": "string", "format": "password", "example": "password123" }
        }
      },
      "AuthResponse": {
        "type": "object",
        "description": "로그인/토큰재발급 성공 응답. refresh_token은 HttpOnly 쿠키(Set-Cookie)로 별도 전달되며 응답 바디에는 포함되지 않는다(PRD 6.3절).",
        "required": ["accessToken", "user"],
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "JWT access_token. Authorization: Bearer 헤더로 사용",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIzZjFiMmM0ZSJ9.abc123signature"
          },
          "user": { "$ref": "#/components/schemas/User" }
        }
      },
      "RefreshResponse": {
        "type": "object",
        "required": ["accessToken"],
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "재발급된 JWT access_token",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIzZjFiMmM0ZSJ9.newsignature"
          }
        }
      },
      "UpdateUserRequest": {
        "type": "object",
        "description": "email은 로그인 식별자이므로 요청 바디에 포함해도 무시되며 응답에는 참고용으로만 포함된다(BR-07).",
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 100, "example": "박민준" }
        }
      },
      "CreateCategoryRequest": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 100, "example": "과제" }
        }
      },
      "CreateTodoRequest": {
        "type": "object",
        "required": ["title", "startDate", "endDate"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 200, "example": "알고리즘 과제 제출" },
          "startDate": { "type": "string", "format": "date", "example": "2026-08-20" },
          "endDate": { "type": "string", "format": "date", "example": "2026-08-27" },
          "categoryId": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "미지정 시 기본 카테고리가 자동 적용된다(BR-03)",
            "example": "9a8b7c6d-5e4f-3a2b-1c0d-9876543210ab"
          }
        }
      },
      "UpdateTodoRequest": {
        "type": "object",
        "description": "전달된 필드만 부분 수정한다. endDate는 startDate 이상이어야 한다(BR-05).",
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 200, "example": "알고리즘 과제 최종 제출" },
          "startDate": { "type": "string", "format": "date", "example": "2026-08-20" },
          "endDate": { "type": "string", "format": "date", "example": "2026-08-30" },
          "categoryId": { "type": "string", "format": "uuid", "example": "9a8b7c6d-5e4f-3a2b-1c0d-9876543210ab" },
          "isDone": { "type": "boolean", "example": true }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "요청 형식/유효성 오류 (예: 필수값 누락, endDate < startDate — BR-05)",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "error": { "code": "VALIDATION_ERROR", "message": "종료일자는 시작일자보다 빠를 수 없습니다." } }
          }
        }
      },
      "Unauthorized": {
        "description": "인증 실패 또는 미인증 (BR-01)",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "error": { "code": "UNAUTHORIZED", "message": "인증이 필요합니다." } }
          }
        }
      },
      "Forbidden": {
        "description": "본인 소유가 아닌 리소스에 대한 접근 (BR-02)",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "error": { "code": "FORBIDDEN", "message": "본인 소유의 리소스만 접근할 수 있습니다." } }
          }
        }
      },
      "NotFound": {
        "description": "대상 리소스가 존재하지 않음",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "error": { "code": "NOT_FOUND", "message": "요청한 리소스를 찾을 수 없습니다." } }
          }
        }
      },
      "Conflict": {
        "description": "중복/제약 위반 (예: email 중복, 카테고리명 중복 — BR-08)",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "error": { "code": "EMAIL_ALREADY_EXISTS", "message": "이미 사용 중인 이메일입니다." } }
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "헬스체크",
        "description": "서버 및 DB 연결 상태를 확인한다.",
        "responses": {
          "200": {
            "description": "정상",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthStatus" },
                "example": { "status": "ok", "db": "ok" }
              }
            }
          },
          "503": {
            "description": "DB 연결 실패 등 비정상",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthStatus" },
                "example": { "status": "error", "db": "error" }
              }
            }
          }
        }
      }
    },
    "/auth/signup": {
      "post": {
        "tags": ["Auth"],
        "summary": "회원가입 (UC-01)",
        "description": "계정 생성과 동시에 기본 카테고리(isDefault=true)가 자동 생성된다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SignupRequest" },
              "example": { "email": "jiwoo@example.com", "password": "password123", "name": "김지우" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "회원가입 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" },
                "example": {
                  "id": "3f1b2c4e-1a2b-4c3d-9e8f-1234567890ab",
                  "email": "jiwoo@example.com",
                  "name": "김지우",
                  "createdAt": "2026-08-26T01:00:00.000Z"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "로그인 (UC-01)",
        "description": "인증 성공 시 access_token은 응답 바디로, refresh_token은 HttpOnly 쿠키로 발급된다(PRD 6.3절).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" },
              "example": { "email": "jiwoo@example.com", "password": "password123" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "로그인 성공",
            "headers": {
              "Set-Cookie": {
                "description": "refresh_token=<jwt>; HttpOnly; Secure; SameSite=Strict",
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthResponse" },
                "example": {
                  "accessToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIzZjFiMmM0ZSJ9.abc123signature",
                  "user": {
                    "id": "3f1b2c4e-1a2b-4c3d-9e8f-1234567890ab",
                    "email": "jiwoo@example.com",
                    "name": "김지우",
                    "createdAt": "2026-08-26T01:00:00.000Z"
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": {
            "description": "email 또는 password 불일치",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": { "code": "INVALID_CREDENTIALS", "message": "이메일 또는 비밀번호가 올바르지 않습니다." } }
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "access_token 재발급 (UC-01)",
        "description": "요청 시 HttpOnly 쿠키에 담긴 refresh_token을 검증해 새 access_token을 발급한다.",
        "parameters": [
          {
            "name": "refresh_token",
            "in": "cookie",
            "required": true,
            "description": "로그인 시 발급된 HttpOnly refresh_token 쿠키",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "재발급 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RefreshResponse" },
                "example": { "accessToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIzZjFiMmM0ZSJ9.newsignature" }
              }
            }
          },
          "401": {
            "description": "refresh_token이 없거나 유효하지 않음/만료됨",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": { "code": "INVALID_REFRESH_TOKEN", "message": "다시 로그인해 주세요." } }
              }
            }
          }
        }
      }
    },
    "/users/me": {
      "patch": {
        "tags": ["Users"],
        "summary": "내 정보 수정 (UC-02)",
        "description": "name만 수정 가능하다. email은 요청 바디에 포함되어도 무시되며 수정되지 않는다(BR-07).",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateUserRequest" },
              "example": { "name": "박민준" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "수정 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" },
                "example": {
                  "id": "3f1b2c4e-1a2b-4c3d-9e8f-1234567890ab",
                  "email": "minjun@example.com",
                  "name": "박민준",
                  "createdAt": "2026-08-20T09:00:00.000Z"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/categories": {
      "get": {
        "tags": ["Categories"],
        "summary": "카테고리 목록 조회",
        "description": "로그인 사용자 본인 소유의 카테고리만 조회된다(BR-02). 기본 카테고리를 포함한다.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Category" } },
                "example": [
                  {
                    "id": "aaaa1111-0000-0000-0000-000000000000",
                    "userId": "3f1b2c4e-1a2b-4c3d-9e8f-1234567890ab",
                    "name": "기본",
                    "isDefault": true,
                    "createdAt": "2026-08-20T09:00:00.000Z"
                  },
                  {
                    "id": "9a8b7c6d-5e4f-3a2b-1c0d-9876543210ab",
                    "userId": "3f1b2c4e-1a2b-4c3d-9e8f-1234567890ab",
                    "name": "과제",
                    "isDefault": false,
                    "createdAt": "2026-08-21T09:00:00.000Z"
                  }
                ]
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "tags": ["Categories"],
        "summary": "카테고리 생성",
        "description": "카테고리명은 사용자별로 유일해야 한다(대소문자 무시, 앞뒤 공백 트림 후 비교 — BR-08, EN-02).",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateCategoryRequest" },
              "example": { "name": "과제" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "생성 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Category" },
                "example": {
                  "id": "9a8b7c6d-5e4f-3a2b-1c0d-9876543210ab",
                  "userId": "3f1b2c4e-1a2b-4c3d-9e8f-1234567890ab",
                  "name": "과제",
                  "isDefault": false,
                  "createdAt": "2026-08-21T09:00:00.000Z"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": {
            "description": "동일 사용자 내 카테고리명 중복 (BR-08)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": { "code": "CATEGORY_NAME_ALREADY_EXISTS", "message": "이미 존재하는 카테고리명입니다." } }
              }
            }
          }
        }
      }
    },
    "/categories/{id}": {
      "delete": {
        "tags": ["Categories"],
        "summary": "카테고리 삭제",
        "description": "기본 카테고리(isDefault=true)는 삭제할 수 없다(BR-04). 일반 카테고리 삭제 시 소속 할일은 모두 기본 카테고리로 자동 이관된다(BR-09).",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" },
            "example": "9a8b7c6d-5e4f-3a2b-1c0d-9876543210ab"
          }
        ],
        "responses": {
          "204": { "description": "삭제 성공" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": {
            "description": "본인 소유가 아니거나(BR-02) 기본 카테고리 삭제 시도(BR-04)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": { "code": "DEFAULT_CATEGORY_DELETE_FORBIDDEN", "message": "기본 카테고리는 삭제할 수 없습니다." } }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
